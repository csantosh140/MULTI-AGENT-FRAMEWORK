import express from 'express';
import cors from 'cors';
import jwt from 'jsonwebtoken';
import sqlite3 from 'sqlite3';
import path from 'path';
import http from 'http';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const PORT = process.env.PORT || 3000;
const JWT_SECRET = 'antigravity_open_secret_key_2026';

// Request Statistics
let totalRequests = 0;
const startTime = new Date();

// Middleware: Parse JSON & URLencoded & Static Files
app.use(express.json());
app.use(express.urlencoded({ extended: true }));
app.use(express.static(__dirname));

// MANDATORY Open CORS Middleware - Allow all origins & ports
app.use((req, res, next) => {
  const origin = req.headers.origin || '*';
  
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS, PATCH');
  res.setHeader('Access-Control-Allow-Headers', 'X-Requested-With, Content-Type, Authorization, Accept, Origin');
  res.setHeader('Access-Control-Allow-Credentials', 'true');

  if (req.method === 'OPTIONS') {
    return res.status(200).json({ status: 'CORS Preflight OK', allowedOrigin: '*' });
  }

  totalRequests++;
  console.log(`[CORS REQUEST #${totalRequests}] ${req.method} ${req.url} | Origin: ${origin}`);
  next();
});

app.use(cors({ origin: '*', credentials: true }));

// ==================== SQLITE DATABASE INITIALIZATION ====================

const dbPath = path.join(__dirname, 'database.sqlite');
const db = new sqlite3.Database(dbPath, (err) => {
  if (err) {
    console.error('❌ Error connecting to SQLite database:', err.message);
  } else {
    console.log('✅ Connected to SQLite database: database.sqlite');
    initDatabaseSchema();
  }
});

function initDatabaseSchema() {
  db.run(`
    CREATE TABLE IF NOT EXISTS users (
      id TEXT PRIMARY KEY,
      name TEXT NOT NULL,
      email TEXT UNIQUE NOT NULL,
      password TEXT NOT NULL,
      role TEXT DEFAULT 'Standard User',
      avatar TEXT,
      created_at TEXT
    )
  `, (err) => {
    if (err) {
      console.error('❌ Error creating table:', err.message);
    } else {
      console.log('✅ Users table ready.');
      seedDefaultRecords();
    }
  });
}

function seedDefaultRecords() {
  db.get('SELECT COUNT(*) AS count FROM users', (err, row) => {
    if (err) return console.error('Error counting users:', err.message);

    if (row.count === 0) {
      console.log('🌱 Seeding initial user records into SQLite database...');
      const seedUsers = [
        {
          id: 'usr_001',
          name: 'Antigravity Explorer',
          email: 'admin@antigravity.io',
          password: 'password123',
          role: 'System Administrator',
          avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80',
          created_at: new Date().toISOString()
        },
        {
          id: 'usr_002',
          name: 'Elena Vance',
          email: 'elena@antigravity.io',
          password: 'securePassword2026',
          role: 'Lead Designer',
          avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Elena',
          created_at: new Date().toISOString()
        },
        {
          id: 'usr_003',
          name: 'Marcus Chen',
          email: 'marcus@antigravity.io',
          password: 'marcusPassWord!',
          role: 'Security Engineer',
          avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Marcus',
          created_at: new Date().toISOString()
        }
      ];

      const stmt = db.prepare('INSERT INTO users (id, name, email, password, role, avatar, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)');
      seedUsers.forEach(u => {
        stmt.run(u.id, u.name, u.email, u.password, u.role, u.avatar, u.created_at);
      });
      stmt.finalize(() => {
        console.log('✅ Successfully seeded 3 records into SQLite database.');
      });
    } else {
      console.log(`ℹ️ Database already contains ${row.count} user records.`);
    }
  });
}

// Helper: Token Authentication Middleware
const authenticateToken = (req, res, next) => {
  const authHeader = req.headers['authorization'];
  const token = authHeader && authHeader.split(' ')[1];

  if (!token) {
    return res.status(401).json({ error: 'Unauthorized', message: 'No authorization token provided' });
  }

  jwt.verify(token, JWT_SECRET, (err, user) => {
    if (err) return res.status(403).json({ error: 'Forbidden', message: 'Token invalid or expired' });
    req.user = user;
    next();
  });
};

