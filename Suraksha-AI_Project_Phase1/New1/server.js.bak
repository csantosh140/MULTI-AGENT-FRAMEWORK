// 1. Health Endpoint
app.get('/api/health', (req, res) => {
  db.get('SELECT COUNT(*) AS totalUsers FROM users', (err, row) => {
    res.json({
      status: 'online',
      serverPort: PORT,
      database: 'SQLite (database.sqlite)',
      databaseRecords: row ? row.totalUsers : 0,
      corsPolicy: 'Unrestricted (*)',
      uptimeSeconds: Math.floor((new Date() - startTime) / 1000),
      totalRequestsReceived: totalRequests
    });
  });
});

// Helper: Real-time Telemetry & Threat Inspection via Suraksha-AI Engine
function inspectWithSurakshaAI(req, endpointName = '/api/login') {
  return new Promise((resolve) => {
    try {
      const payload = req.body || {};
      const postData = JSON.stringify({
        source_app: 'New1 Target App',
        url: endpointName,
        method: req.method,
        payload: payload,
        client_ip: req.ip || req.socket?.remoteAddress || '127.0.0.1',
        user_agent: req.headers['user-agent'] || 'Mozilla/5.0'
      });

      const options = {
        hostname: '127.0.0.1',
        port: 5000,
        path: '/api/target/telemetry',
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Content-Length': Buffer.byteLength(postData)
        },
        timeout: 2500
      };

      const surakshaReq = http.request(options, (surakshaRes) => {
        let responseBody = '';
        surakshaRes.on('data', (chunk) => { responseBody += chunk; });
        surakshaRes.on('end', () => {
          try {
            const data = JSON.parse(responseBody);
            if (surakshaRes.statusCode === 403 || data?.data?.blocked || data?.data?.verdict === 'BLOCKED') {
              return resolve({
                blocked: true,
                reason: data?.data?.reason || 'SQL Injection Intercepted by Suraksha-AI Security Shield'
              });
            }
          } catch (e) {}
          resolve({ blocked: false });
        });
      });

      surakshaReq.on('error', (err) => {
        console.log('⚠️ [Suraksha-AI Inspection] Telemetry service notice:', err.message);
        resolve({ blocked: false });
      });

      surakshaReq.on('timeout', () => {
        surakshaReq.destroy();
        resolve({ blocked: false });
      });

      surakshaReq.write(postData);
      surakshaReq.end();
    } catch (err) {
      resolve({ blocked: false });
    }
  });
}

// SSE Client Broadcast Connections
const sseClients = [];

app.get('/api/live-attacks-stream', (req, res) => {
  res.setHeader('Content-Type', 'text/event-stream');
  res.setHeader('Cache-Control', 'no-cache');
  res.setHeader('Connection', 'keep-alive');
  res.setHeader('Access-Control-Allow-Origin', '*');

  res.write('data: {"status":"connected"}\n\n');
  sseClients.push(res);

  req.on('close', () => {
    const idx = sseClients.indexOf(res);
    if (idx !== -1) sseClients.splice(idx, 1);
  });
});

function broadcastAttackToBrowsers(payload, status) {
  const data = JSON.stringify({ payload, status, time: new Date().toISOString() });
  sseClients.forEach(client => {
    client.write(`data: ${data}\n\n`);
  });
}

// 2. User Login Endpoint (Database Processed with Suraksha-AI Defense)
app.post('/api/login', async (req, res) => {
  const { email, password } = req.body;

  if (!email || !password) {
    return res.status(400).json({ error: 'Missing Fields', message: 'Please provide email address and password' });
  }

  // Broadcast attack vector to active browser login UI for visual typing animation
  broadcastAttackToBrowsers(email || password, 'BLOCKED');

  // Active Suraksha-AI Security Inspection
  const securityCheck = await inspectWithSurakshaAI(req, '/api/login');
  if (securityCheck.blocked) {
    console.log(`🚨 [SURAKSHA-AI WAF BLOCK] SQL Injection Attempt Intercepted: ${securityCheck.reason}`);
    return res.status(403).json({
      error: 'Security Threat Intercepted',
      message: `🚨 Blocked by Suraksha-AI Security System: ${securityCheck.reason}`,
      blocked: true,
      suraksha_verdict: 'BLOCKED'
    });
  }

  // Parameterized Query: Query user by email from SQLite Database
  db.get('SELECT * FROM users WHERE LOWER(email) = LOWER(?)', [email], (err, user) => {
    if (err) {
      console.error('Database query error:', err.message);
      return res.status(500).json({ error: 'Database Error', message: 'Internal server query error' });
    }

    if (!user || user.password !== password) {
      return res.status(401).json({ error: 'Authentication Failed', message: 'Invalid email or password credentials' });
    }

    // Generate JWT Token
    const accessToken = jwt.sign(
      { id: user.id, email: user.email, name: user.name, role: user.role },
      JWT_SECRET,
      { expiresIn: '24h' }
    );

    return res.json({
      success: true,
      message: 'Login successful!',
      token: accessToken,
      tokenType: 'Bearer',
      expiresIn: '24 Hours',
      user: {
        id: user.id,
        name: user.name,
        email: user.email,
        role: user.role,
        avatar: user.avatar
      },
      clientOrigin: req.headers.origin || 'Direct API Call',
      serverPort: PORT
    });
  });
});

// 3. User Registration Endpoint (Database Insert)
app.post('/api/register', (req, res) => {
  const { name, email, password } = req.body;

  if (!name || !email || !password) {
    return res.status(400).json({ error: 'Missing Fields', message: 'Name, email, and password are required' });
  }

  // Check if user exists in database
  db.get('SELECT id FROM users WHERE LOWER(email) = LOWER(?)', [email], (err, existing) => {
    if (err) {
      return res.status(500).json({ error: 'Database Error', message: 'Database check failed' });
    }

    if (existing) {
      return res.status(409).json({ error: 'User Exists', message: 'A user with this email address already exists' });
    }

    const newUser = {
      id: `usr_${Date.now()}`,
      name,
      email,
      password,
      role: 'Standard User',
      avatar: `https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(name)}`,
      created_at: new Date().toISOString()
    };

    // Parameterized Insert Statement
    const stmt = db.prepare('INSERT INTO users (id, name, email, password, role, avatar, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)');
    stmt.run(
      newUser.id,
      newUser.name,
      newUser.email,
      newUser.password,
      newUser.role,
      newUser.avatar,
      newUser.created_at,
      function (err) {
        if (err) {
          console.error('Insert error:', err.message);
          return res.status(500).json({ error: 'Database Error', message: 'Failed to insert user into database' });
        }

        const accessToken = jwt.sign(
          { id: newUser.id, email: newUser.email, name: newUser.name, role: newUser.role },
          JWT_SECRET,
          { expiresIn: '24h' }
        );

        return res.status(201).json({
          success: true,
          message: 'User account created and saved to database!',
          token: accessToken,
          tokenType: 'Bearer',
          user: {
            id: newUser.id,
            name: newUser.name,
            email: newUser.email,
            role: newUser.role,
            avatar: newUser.avatar
          },
          clientOrigin: req.headers.origin || 'Direct API Call'
        });
      }
    );
    stmt.finalize();
  });
});

// 4. Get User Profile (Database Query via Authenticated Token)
app.get('/api/user', authenticateToken, (req, res) => {
  db.get('SELECT id, name, email, role, avatar, created_at FROM users WHERE id = ?', [req.user.id], (err, user) => {
    if (err || !user) {
      return res.status(404).json({ error: 'Not Found', message: 'User profile not found in database' });
    }

    res.json({
      success: true,
      user: {
        id: user.id,
        name: user.name,
        email: user.email,
        role: user.role,
        avatar: user.avatar,
        createdAt: user.created_at
      },
      clientOrigin: req.headers.origin || 'Direct API Call',
      accessedAt: new Date().toISOString()
    });
  });
});

